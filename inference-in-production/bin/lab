#!/usr/bin/env bash
# The dispatcher behind the one command the book prints:
#
#   docker compose run --rm inference-in-production chNN
#
# chNN          run chNN/run.sh (extra arguments are passed on);
#               its stdout is also saved to measured/chNN/output.txt
# test chNN     run chNN/test.sh, which asserts the lab's invariants
# list          list the labs present in this checkout
# models [SET]  download and verify lab models (default set: smoke)
# models list   list the model sets and their sizes
# clean         remove any lab containers a crashed run left behind
# apple         print the native Apple-silicon (Metal) commands
# shell         open a shell in the runner
set -euo pipefail

ROOT=/lab

usage() {
  sed -n '2,14p' "$ROOT/bin/lab" | sed 's/^# \{0,1\}//'
}

labs() {
  local d
  for d in "$ROOT"/ch[0-9][0-9]; do
    [ -f "$d/run.sh" ] && basename "$d"
  done
  return 0
}

run_lab() {
  local lab=$1 script=$2
  shift 2
  if [ ! -f "$ROOT/$lab/$script" ]; then
    echo "no $lab/$script in this checkout." >&2
    echo "labs present: $(labs | tr '\n' ' ')" >&2
    exit 2
  fi
  export LAB=$lab LAB_DIR=$ROOT/$lab
  export MEASURED=$ROOT/measured/$lab WORK=$ROOT/.work/$lab
  mkdir -p "$MEASURED" "$WORK"
  cd "$LAB_DIR"
  if [ "$script" = run.sh ]; then
    # The transcript is recorded too: README "Expected output"
    # blocks are copied from measured/chNN/output.txt.
    bash run.sh "$@" | tee "$MEASURED/output.txt"
  else
    exec bash "$script" "$@"
  fi
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case "$cmd" in
  ch[0-9][0-9]) run_lab "$cmd" run.sh "$@" ;;
  test)
    [ $# -ge 1 ] || { echo "usage: test chNN" >&2; exit 2; }
    lab=$1
    shift
    run_lab "$lab" test.sh "$@"
    ;;
  list) labs ;;
  models)
    if [ "${1:-}" = list ]; then
      exec python3 "$ROOT/scripts/fetch_models.py" list
    fi
    exec python3 "$ROOT/scripts/fetch_models.py" fetch "$@"
    ;;
  clean)
    mapfile -t ids < <(docker ps -aq --filter label=aiel.lab)
    [ ${#ids[@]} -eq 0 ] || docker rm -f "${ids[@]}" >/dev/null
    echo "removed ${#ids[@]} lab container(s)"
    ;;
  apple) cat "$ROOT/apple/README.md" ;;
  shell|bash) exec bash "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
