{
  "uid": "book-screens",
  "title": "Book screens",
  "description": "Panels the book captures that vLLM's own dashboards do not ship. Built by screens/make_dashboards.py.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "utc",
  "refresh": "",
  "panels": [
    {
      "id": 2,
      "type": "timeseries",
      "title": "Preemptions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "requests preempted",
            "axisPlacement": "auto",
            "axisBorderShow": true,
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "axisSoftMax": 2.5
          },
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#1a1a1a"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Preemptions (6m increase)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1a1a1a"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "solid"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2.4
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "increase(vllm:num_preemptions_total[6m])",
          "legendFormat": "Preemptions (6m increase)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ]
    },
