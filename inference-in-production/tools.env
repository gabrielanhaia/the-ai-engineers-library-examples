# Files the kind-based labs (ch14, ch16, ch18) download at run time,
# pinned by URL AND SHA-256: the binaries the runner image does not
# carry, and the upstream manifests the labs apply. lib/kind.sh
# fetches each one once into .work/tools/ and refuses a file whose
# hash differs. docs/versions.md says why each version.
#
# Format: NAME=URL@sha256:HEX. Binaries have one entry per
# architecture (_AMD64, _ARM64); lib/kind.sh picks the runner's.

# kind v0.33.0 (2026-08-26). Its node image is KIND_NODE_IMAGE in
# images.env.
KIND_AMD64=https://github.com/kubernetes-sigs/kind/releases/download/v0.33.0/kind-linux-amd64@sha256:aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_ARM64=https://github.com/kubernetes-sigs/kind/releases/download/v0.33.0/kind-linux-arm64@sha256:20022bee6cfcd5086cb7234d218e3454e6090022f2a8f55d1fa7fcf42c3867a2

# kubectl v1.36.4, the same minor as the node image.
KUBECTL_AMD64=https://dl.k8s.io/release/v1.36.4/bin/linux/amd64/kubectl@sha256:8b8f088da2dab964f853b38464033b1be15ede2839eca751482357c45abdd05a
KUBECTL_ARM64=https://dl.k8s.io/release/v1.36.4/bin/linux/arm64/kubectl@sha256:0ecf44450ee6063bf19dd166a103ee6df4a9034455c2abce626e6eea657d73fb

# istioctl 1.30.4 (a tarball holding the one binary). Installs the
# lab's Gateway API implementation (ch14).
ISTIOCTL_AMD64=https://github.com/istio/istio/releases/download/1.30.4/istioctl-1.30.4-linux-amd64.tar.gz@sha256:feda625a00dfc69135f4692442ef66eb2fa8aea848b483348c330a1138fe392f
ISTIOCTL_ARM64=https://github.com/istio/istio/releases/download/1.30.4/istioctl-1.30.4-linux-arm64.tar.gz@sha256:1045d90978d5cc46ad77a7447bebf1a26c66c796c4499bbd83f62cfcb4631f95

# Gateway API v1.5.1, standard channel: the CRDs Istio 1.30.4, the
# Gateway API Inference Extension v1.6.2 and llm-d-router v0.10.0
# are all built against.
GATEWAY_API_CRDS=https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.5.1/standard-install.yaml@sha256:751002b3b91a87f7ae3bd2517c79a47a8d7ed6702901808a1cf9bd97d284f9b8

# Gateway API Inference Extension v1.6.2: the InferencePool CRD
# (inference.networking.k8s.io/v1) only.
GAIE_CRDS=https://github.com/kubernetes-sigs/gateway-api-inference-extension/releases/download/v1.6.2/v1-manifests.yaml@sha256:f410dfca474608c02903087b47f1ac081706dfb6dfe7f83d00a7cc7e00c4ad0d

# llm-d-router v0.10.0: the llm-d.ai CRDs (InferenceObjective,
# InferenceModelRewrite).
ROUTER_CRDS=https://github.com/llm-d/llm-d-router/releases/download/v0.10.0/manifests.yaml@sha256:488c0f48f4d41067d2319e20761bae1e531cfcfc8c73ba979067365302ec1df0

# KEDA v2.20.2: CRDs, operator, metrics server and webhooks (ch16).
# lib/kind.sh swaps its three image tags for the digests in
# images.env before applying it.
KEDA_MANIFEST=https://github.com/kedacore/keda/releases/download/v2.20.2/keda-2.20.2.yaml@sha256:9bae123eb64fab8f96c67bbd576bb5819e4794df346c5aaa402a01c68b0557ab

# vLLM v0.29.0's own Grafana dashboards (ch15), from
# examples/observability at the v0.29.0 tag.
VLLM_DASHBOARD=https://raw.githubusercontent.com/vllm-project/vllm/v0.29.0/examples/observability/prometheus_grafana/grafana.json@sha256:651f1cf353024072197214df101a6f641839099736939b22b2f46b11c9faf527
VLLM_DASHBOARD_PERF=https://raw.githubusercontent.com/vllm-project/vllm/v0.29.0/examples/observability/dashboards/grafana/performance_statistics.json@sha256:507f481a47ed3606826aa373704dd84b28dfc311456398fed73dc992d649c637
VLLM_DASHBOARD_QUERY=https://raw.githubusercontent.com/vllm-project/vllm/v0.29.0/examples/observability/dashboards/grafana/query_statistics.json@sha256:459de6707d482b462fc3922b5964a743bd5b2cc1f45365661eb04d7b7fd1faaa
